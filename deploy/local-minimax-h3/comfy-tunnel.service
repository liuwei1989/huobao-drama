[Unit]
Description=SSH tunnel to GPU box ComfyUI (127.0.0.1:8188)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/ssh -i /root/.ssh/id_ed25519 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o ExitOnForwardFailure=yes -N -L 127.0.0.1:8188:127.0.0.1:8188 -p 26096 root@connect.westd.seetacloud.com
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
